{
    "name": "drewlabs/app",
    "type": "project",
    "description": "HTTP Api.",
    "keywords": ["laravel", "HTTP", "Api"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "drewlabs/laravel-query": "^0.4.0",
        "drewlabs/support": "^0.4.0",
        "drewlabs/validation": "^0.4.0",
        "drewlabs/php-value": "^0.3.0",
        "laravel/framework": "^13.0",
        "nyholm/psr7": "^1.8"
    },
    "require-dev": {
        "drewlabs/g-cli": "^0.4.0",
        "laravel/tinker": "^3.0",
        "phpunit/phpunit": "^13.0",
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.2",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],        
        "project-create": [
            "@php artisan gcli:make:project --srcPath=app --force --disableCache --http --relations --policies --htr --no-model-accessors --input=database/automation/model.json"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan serve --port=17650"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
